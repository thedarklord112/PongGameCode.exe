import pygame
import random

# Initialize Pygame
pygame.init()

# Constants
WIDTH, HEIGHT = 800, 600
WHITE = (255, 255, 255)
BLACK = (0, 0, 0)
RED = (255, 50, 50)
BLUE = (50, 50, 255)
GOLD = (255, 215, 0)
FPS = 60

# Setup Screen
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Power-Up Pong: The Hybrid")
clock = pygame.time.Clock()

# Game Objects
ball = pygame.Rect(WIDTH//2, HEIGHT//2, 20, 20)
ball_speed = [5 * random.choice((1, -1)), 5 * random.choice((1, -1))]

player = pygame.Rect(50, HEIGHT//2 - 50, 15, 100)
opponent = pygame.Rect(WIDTH - 65, HEIGHT//2 - 50, 15, 100)

# Scores
player_score = 0
opponent_score = 0
font = pygame.font.SysFont("Arial", 30)

# Power-up (RPG/Adventure element: Collectible gold block)
powerup = pygame.Rect(random.randint(200, 600), random.randint(100, 500), 25, 25)
powerup_active = True

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

    # Movement (Classic controls)
    keys = pygame.key.get_pressed()
    if keys[pygame.K_w] and player.top > 0: player.y -= 7
    if keys[pygame.K_s] and player.bottom < HEIGHT: player.y += 7

    # Basic AI (Opponent)
    if opponent.centery < ball.centery: opponent.y += 5
    else: opponent.y -= 5

    # Ball Physics
    ball.x += ball_speed[0]
    ball.y += ball_speed[1]

    # Wall Collision
    if ball.top <= 0 or ball.bottom >= HEIGHT:
        ball_speed[1] *= -1

    # Paddle Collision + Arcade Element (Increasing Speed)
    if ball.colliderect(player) or ball.colliderect(opponent):
        ball_speed[0] *= -1.1 # Ball gets faster each hit!

    # Power-up Logic (If the ball touches the gold block, it gets a "Turbo Boost")
    if powerup_active and ball.colliderect(powerup):
        ball_speed[0] *= 1.5 
        powerup_active = False 

    # Scoring & Reset
    if ball.left <= 0:
        opponent_score += 1
        ball.center = (WIDTH//2, HEIGHT//2)
        ball_speed = [5, 5]
        powerup_active = True # Respawn item
    if ball.right >= WIDTH:
        player_score += 1
        ball.center = (WIDTH//2, HEIGHT//2)
        ball_speed = [-5, 5]
        powerup_active = True

    # Drawing
    screen.fill(BLACK)
    pygame.draw.ellipse(screen, WHITE, ball)
    pygame.draw.rect(screen, BLUE, player)
    pygame.draw.rect(screen, RED, opponent)
    
    if powerup_active:
        pygame.draw.rect(screen, GOLD, powerup) # Draw the Power-up

    # HUD
    score_text = font.render(f"P1: {player_score}  |  CPU: {opponent_score}", True, WHITE)
    screen.blit(score_text, (WIDTH//2 - 100, 20))

    pygame.display.flip()
    clock.tick(FPS)

pygame.quit()
